# Fase 9f — variables para `docker compose up`. Copiar a `.env` (que NO se
# versiona) y completar con valores reales antes de desplegar.

POSTGRES_USER=vocacional
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=vocacional_db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIA_ESTE_SECRETO_EN_PRODUCCION

# Dominio(s) real(es) del frontend desplegado, en formato lista JSON.
CORS_ORIGINS=["https://tu-dominio-frontend.com"]

# URL pública real del backend (se incrusta en el bundle del frontend en
# build time, ver frontend/Dockerfile).
NEXT_PUBLIC_API_URL=https://tu-dominio-backend.com
